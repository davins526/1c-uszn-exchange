// Публичная версия модуля формы обработки обмена с УСЗН.
// Распознавание услуг и сохранение соответствий по ссылкам.
// Правила, привязанные к конкретным адресам и периодам, удалены.
// Настройки услуг: таблица формы НастройкиУслуг с колонками
// ВидРасчета (СправочникСсылка.ркВидыРасчетов),
// ТипРасчета (ПеречислениеСсылка.ркТипыВидовРасчетов),
// КатегорияОбмена (Строка 100).
// Элемент колонки: НастройкиУслугКатегорияОбмена.
// Основные команды: загрузить файл, заполнить ЛС, заполнить суммы,
// сохранить файл, обновить и сбросить настройки услуг.
// Настройки сохраняются для текущего пользователя текущей базы.
// Агрегирование сумм, алгоритм задолженности и признаки договоров
// сохранены из исходного модуля; соответствие соглашению этих формул
// требует отдельной проверки. Сопоставление услуг выполняется по ссылкам.

// Обработка обмена с УСЗН.
// Порядок: Загрузить файл → Заполнить ЛС → Заполнить суммы → Сохранить.


#Область ОбработчикиСобытийТаблицыФормы

// Открывает карточку лицевого счёта при переходе по гиперссылке.
&НаКлиенте
Процедура ТаблицаФайлаСсылкаНаЛСОткрытие(Элемент, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ТаблицаФайла.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено 
		ИЛИ Не ЗначениеЗаполнено(ТекущаяСтрока.СсылкаНаЛС) Тогда
		Возврат;
	КонецЕсли;
	
	НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ТекущаяСтрока.СсылкаНаЛС);
	ПерейтиПоНавигационнойСсылке(НавигационнаяСсылка);
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

// Кнопка "Загрузить файл". Диалог выбора → чтение DBF на клиенте.
&НаКлиенте
Процедура ПрочитатьФайл(Команда)
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Фильтр = "DBF файлы (*.dbf)|*.dbf";
	Если Не ДиалогВыбора.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	Если ПрочитатьDBFИзФайла(ДиалогВыбора.ПолноеИмяФайла) Тогда
		ПутьИсходногоФайла = ДиалогВыбора.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

// Кнопка "Заполнить ЛС".
&НаКлиенте
Процедура ЗаполнитьЛС(Команда)

	Если ТаблицаФайла.Количество() = 0 Тогда
		ВывестиСообщение("Сначала прочитайте файл");
		Возврат;
	КонецЕсли;

	СостояниеПодбора = ЗаполнитьЛицевыеСчетаНаСервере();

	ВывестиСообщение(
		"Заполнено ЛС: " + СостояниеПодбора.Заполнено
		+ ", не найдено или неоднозначно: "
		+ СостояниеПодбора.НеНайдено);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСуммы(Команда)
	
	Если ТаблицаФайла.Количество() = 0 Тогда
		ВывестиСообщение("Сначала прочитайте файл");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСуммыНаСервере();
	
КонецПроцедуры

// Кнопка "Сохранить". Формирует O-файл на основе исходного Z-файла.
&НаКлиенте
Процедура Сохранить(Команда)
	
	Если ТаблицаФайла.Количество() = 0 Тогда
		ВывестиСообщение("Таблица пустая - нечего сохранять");
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ПутьИсходногоФайла) Тогда
		ВывестиСообщение("Сначала прочитайте исходный файл");
		Возврат;
	КонецЕсли;
	
	ИмяОтвета    = ПолучитьИмяФайлаОтвета(ПутьИсходногоФайла);
	КаталогФайла = ПолучитьКаталогФайла(ПутьИсходногоФайла);
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогВыбора.Фильтр         = "DBF файлы (*.dbf)|*.dbf";
	ДиалогВыбора.Заголовок      = "Сохранить файл-ответ для УСЗН";
	ДиалогВыбора.Каталог        = КаталогФайла;
	ДиалогВыбора.ПолноеИмяФайла = КаталогФайла + ИмяОтвета;
	
	Если Не ДиалогВыбора.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	ПутьСохранения = ДиалогВыбора.ПолноеИмяФайла;
	Если Прав(ПутьСохранения, 4) <> ".dbf" Тогда
		ПутьСохранения = ПутьСохранения + ".dbf";
	КонецЕсли;
	
	СохранитьФайлНаКлиенте(ПутьИсходногоФайла, ПутьСохранения);
	
КонецПроцедуры

// Кнопка "Открыть ЛС".
&НаКлиенте
Процедура ОткрытьЛС(Команда)
	
	ТекущаяСтрока = Элементы.ТаблицаФайла.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		ВывестиСообщение("Выберите строку");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.СсылкаНаЛС) Тогда
		ВывестиСообщение("У строки нет лицевого счёта");
		Возврат;
	КонецЕсли;
	
	НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ТекущаяСтрока.СсылкаНаЛС);
	ПерейтиПоНавигационнойСсылке(НавигационнаяСсылка);
	
КонецПроцедуры

// Команда "Виды" обновляет таблицу соответствий услуг.
&НаКлиенте
Процедура ПоказатьВиды(Команда)
	ЗагрузитьВидыРасчетаНаСервере();
	ВывестиСообщение("Соответствия доступны в таблице настроек услуг.");
КонецПроцедуры

#КонецОбласти


#Область РаботаСФайламиНаКлиенте

// Получает кодировку на клиенте без передачи КодировкаXBase с сервера.
&НаКлиенте
Функция КодировкаOEMXBase()

	Возврат ПредопределенноеЗначение("КодировкаXBase.OEM");

КонецФункции

// Читает DBF и заполняет таблицу на форме. Работает на клиенте.
&НаКлиенте
Функция ПрочитатьDBFИзФайла(Знач ПутьИсходногоФайла)
	
	ТаблицаФайла.Очистить();
	
	// XBase не читает длинные пути — работаем через TEMP + короткое имя
	ВременныйПуть = ПодготовитьВременныйПуть("z.dbf");
	Если ПустаяСтрока(ВременныйПуть) Тогда
		ВывестиСообщение("Не удалось подготовить временный каталог");
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		КопироватьФайл(ПутьИсходногоФайла, ВременныйПуть);
	Исключение
		ВывестиСообщение("Не удалось скопировать файл. Возможно, он занят. " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	РезультатЧтения = ПрочитатьDBF(ВременныйПуть);
	
	Попытка
		УдалитьФайлы(ВременныйПуть);
	Исключение
		// Не критично
	КонецПопытки;
	
	Возврат РезультатЧтения;
	
КонецФункции

// Читает записи DBF-файла в таблицу формы.
&НаКлиенте
Функция ПрочитатьDBF(Путь)
	
	ФайлDBF = Новый XBase;
	ФайлDBF.Кодировка = КодировкаOEMXBase();
	СписокПолей = ВсеПоляDBF();
	
	Попытка
		ФайлDBF.ОткрытьФайл(Путь);
	Исключение
		ВывестиСообщение("Не удалось открыть файл: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		ПерваяСтрока = Истина;
		Пока ПерваяСтрока ИЛИ ФайлDBF.Следующая() Цикл
			ПерваяСтрока = Ложь;
			
			НоваяСтрока = ТаблицаФайла.Добавить();
			Для Каждого ИмяПоля Из СписокПолей Цикл
				Если ФайлDBF.Поля.Найти(ИмяПоля) <> Неопределено Тогда
					НоваяСтрока[ИмяПоля] = ФайлDBF[ИмяПоля];
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Исключение
		ВывестиСообщение("Ошибка чтения файла: " + ОписаниеОшибки());
		ЗакрытьФайлDBF(ФайлDBF);
		Возврат Ложь;
	КонецПопытки;
	
	ЗакрытьФайлDBF(ФайлDBF);
	
	ВывестиСообщение("Загружено строк: " + ТаблицаФайла.Количество());
	Возврат Истина;
	
КонецФункции

// Сохраняет файл-ответ. Копия исходника → запись данных → итоговый файл.
&НаКлиенте
Процедура СохранитьФайлНаКлиенте(Знач ПутьИсходногоФайла, Знач ПутьСохранения)
	
	ВременныйПуть = ПодготовитьВременныйПуть("o.dbf");
	Если ПустаяСтрока(ВременныйПуть) Тогда
		ВывестиСообщение("Не удалось подготовить временный каталог");
		Возврат;
	КонецЕсли;
	
	Попытка
		КопироватьФайл(ПутьИсходногоФайла, ВременныйПуть);
	Исключение
		ВывестиСообщение("Не удалось создать временную копию: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Попытка
		РезультатЗаписи = ПерезаписатьDBF(ВременныйПуть);
	Исключение
		ВывестиСообщение("Ошибка при записи: " + ОписаниеОшибки());
		РезультатЗаписи = Ложь;
	КонецПопытки;
	
	Если РезультатЗаписи Тогда
		Попытка
			КопироватьФайл(ВременныйПуть, ПутьСохранения);
			ВывестиСообщение("Файл сохранён: " + ПутьСохранения);
		Исключение
			ВывестиСообщение("Не удалось записать итоговый файл (возможно, он открыт): " 
				+ ОписаниеОшибки());
		КонецПопытки;
	Иначе
		ВывестиСообщение("Файл не был сохранён из-за ошибок при записи");
	КонецЕсли;
	
	Попытка
		УдалитьФайлы(ВременныйПуть);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

// Записывает данные из таблицы в DBF.
// Числовые поля пишем через Формат — XBase иначе сохранит 0 как пробелы.
&НаКлиенте
Функция ПерезаписатьDBF(Путь)
	
	ФайлDBF = Новый XBase;
	ФайлDBF.Кодировка = КодировкаOEMXBase();
	СписокПолей = ВсеПоляDBF();
	
	Попытка
		ФайлDBF.ОткрытьФайл(Путь);
	Исключение
		ВывестиСообщение("Не удалось открыть файл для записи: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		Для Каждого СтрокаТаблицы Из ТаблицаФайла Цикл
			
			Для Каждого ИмяПоля Из СписокПолей Цикл
				
				Если ФайлDBF.Поля.Найти(ИмяПоля) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ЗначениеПоля = СтрокаТаблицы[ИмяПоля];
				Если ТипЗнч(ЗначениеПоля) = Тип("Число") Тогда
					ФайлDBF[ИмяПоля] = Формат(ЗначениеПоля, "ЧГ=0; ЧДЦ=2");
				Иначе
					ФайлDBF[ИмяПоля] = ЗначениеПоля;
				КонецЕсли;
				
			КонецЦикла;
			
			ФайлDBF.Записать();
			
			Если Не ФайлDBF.Следующая() Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
	Исключение
		ВывестиСообщение("Ошибка при записи в файл: " + ОписаниеОшибки());
		ЗакрытьФайлDBF(ФайлDBF);
		Возврат Ложь;
	КонецПопытки;
	
	ЗакрытьФайлDBF(ФайлDBF);
	
	Возврат Истина;
	
КонецФункции

// Готовит короткий путь для временного файла в каталоге TEMP.
// XBase не читает длинные имена, поэтому имя короткое (z.dbf, o.dbf).
&НаКлиенте
Функция ПодготовитьВременныйПуть(ИмяФайла)
	
	Каталог = КаталогВременныхФайлов();
	Если ПустаяСтрока(Каталог) Тогда
		Возврат "";
	КонецЕсли;
	
	// Гарантируем завершающий слеш
	Если Прав(Каталог, 1) <> "\" Тогда
		Каталог = Каталог + "\";
	КонецЕсли;
	
	Возврат Каталог + ИмяФайла;
	
КонецФункции

// Формирует имя файла ответа: "Z..." → "O..."
&НаКлиенте
Функция ПолучитьИмяФайлаОтвета(ПутьИсходногоФайла)
	
	ИмяФайлаЗапроса = ИмяФайлаИзПути(ПутьИсходногоФайла);
	
	Если ВРег(Лев(ИмяФайлаЗапроса, 1)) = "Z" Тогда
		Возврат "O" + Сред(ИмяФайлаЗапроса, 2);
	Иначе
		Возврат "O" + ИмяФайлаЗапроса;
	КонецЕсли;
	
КонецФункции

// Возвращает каталог из полного пути.
&НаКлиенте
Функция ПолучитьКаталогФайла(ПутьИсходногоФайла)
	
	ИмяФайлаЗапроса = ИмяФайлаИзПути(ПутьИсходногоФайла);
	Возврат Лев(ПутьИсходногоФайла, 
		СтрДлина(ПутьИсходногоФайла) - СтрДлина(ИмяФайлаЗапроса));
	
КонецФункции

// Возвращает имя файла из полного пути.
&НаКлиенте
Функция ИмяФайлаИзПути(Знач Путь)
	
	ЧастиПути = СтрРазделить(Путь, "\");
	Возврат ЧастиПути[ЧастиПути.Количество() - 1];
	
КонецФункции

// Закрывает файл DBF, подавляя ошибку закрытия.
&НаКлиенте
Процедура ЗакрытьФайлDBF(ФайлDBF)
	
	Попытка
		ФайлDBF.ЗакрытьФайл();
	Исключение
		// Уже закрыт
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти


#Область ПоискЛицевыхСчетовНаСервере

// Ищет ЛС для всех строк, пишет в GLAVA1 и СсылкаНаЛС. Неоднозначные адреса пропускает без выбора.  
// KOD — код семьи из файла УСЗН, а не номер договора или ЛС.



&НаСервере
Функция ЗаполнитьЛицевыеСчетаНаСервере()

	Результат = Новый Структура(
		"Заполнено, НеНайдено",
		0, 0);

	// Каждый адрес дома запрашиваем один раз за запуск.
	КэшДомов = Новый Соответствие;

	Для ИндексСтроки = 0 По ТаблицаФайла.Количество() - 1 Цикл

		СтрокаТаблицы = ТаблицаФайла[ИндексСтроки];

		// При новом подборе старые суммы не должны остаться
		// от ранее выбранного лицевого счета.
		ОбнулитьПоляСтроки(СтрокаТаблицы);
		СтрокаТаблицы.GLAVA1 = "";
		СтрокаТаблицы.СсылкаНаЛС =
			Справочники.ркЛицевыеСчета.ПустаяСсылка();

		Улица = СокрЛП(СтрокаТаблицы.STREET);
		Дом = СокрЛП(СтрокаТаблицы.HOUSE);
		Корпус = СокрЛП(СтрокаТаблицы.KORP);
		Квартира = СокрЛП(СтрокаТаблицы.FLAT);

		КлючДома = Улица + "|" + Дом + "|" + Корпус;
		КандидатыДома = КэшДомов.Получить(КлючДома);

		Если КандидатыДома = Неопределено Тогда
			КандидатыДома = НайтиЛСПоАдресуБезКвартиры(
				Улица, Дом, Корпус);
			КэшДомов.Вставить(КлючДома, КандидатыДома);
		КонецЕсли;

		ПодходящиеЛС = Новый Массив;
		ВариантыКвартиры = Новый Массив;

		Если Не ПустаяСтрока(Квартира) Тогда
			ВариантыКвартиры = ВариантыНаписанияКвартиры(
				Квартира);
		КонецЕсли;

		Для Каждого Кандидат Из КандидатыДома Цикл

			// Если квартира пустая, рассматриваем весь дом.
			// Если заполнена — отбираем по номеру помещения.
			Если Не ПустаяСтрока(Квартира) Тогда
				Если ВариантыКвартиры.Найти(
					СокрЛП(Кандидат.НомерПомещения))
					= Неопределено Тогда

					Продолжить;
				КонецЕсли;
			КонецЕсли;

			ПодходящиеЛС.Добавить(Кандидат);

		КонецЦикла;

		Если ПодходящиеЛС.Количество() = 1 Тогда

			СтрокаТаблицы.СсылкаНаЛС =
				ПодходящиеЛС[0].Ссылка;
			СтрокаТаблицы.GLAVA1 =
				ПодходящиеЛС[0].Код;

			Результат.Заполнено = Результат.Заполнено + 1;

		ИначеЕсли ПодходящиеЛС.Количество() = 0 Тогда

			Результат.НеНайдено = Результат.НеНайдено + 1;

			ВывестиСообщение(
				"ЛС не найден: " + Улица
				+ ", дом " + Дом
				+ ", корпус [" + Корпус
				+ "], квартира [" + Квартира + "]");

		Иначе

			// Автоматический обмен не выбирает ЛС вручную.
			// Несколько кандидатов считаются неоднозначным адресом.
			Результат.НеНайдено = Результат.НеНайдено + 1;
			ВывестиСообщение(
				"ЛС не определен однозначно: " + Улица
				+ ", дом " + Дом
				+ ", корпус [" + Корпус
				+ "], квартира [" + Квартира + "]"
				+ ". Кандидатов: " + ПодходящиеЛС.Количество());

		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции	
// Диагностический поиск без условия по квартире и без изменения адреса файла.
// Возвращает всех ЛС по улице, дому и корпусу, включая закрытые:
// их применимость к периоду следует проверить при разборе кандидатов.
&НаСервере
Функция НайтиЛСПоАдресуБезКвартиры(Знач Улица, Знач Дом, Знач Корпус)

	Результат = Новый Массив;
	УлицаПоиска = ПодготовитьУлицу(Улица);
	ДомПоиска = НормализоватьЗначение(Дом);
	КорпусПоиска = НормализоватьЗначение(Корпус);
	Если ПустаяСтрока(УлицаПоиска) ИЛИ ПустаяСтрока(ДомПоиска) Тогда
		Возврат Результат;
	КонецЕсли;

	УлицыПоиска = Новый Массив;
	ДобавитьВМассивБезДублей(УлицыПоиска, ВРег(СокрЛП(Улица)));
	ДобавитьВМассивБезДублей(УлицыПоиска, УлицаПоиска);
	ДобавитьВМассивБезДублей(УлицыПоиска, УлицаПоиска + " УЛ");
	ДобавитьВМассивБезДублей(УлицыПоиска, "УЛ. " + УлицаПоиска);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| ЛС.Ссылка КАК Ссылка,
		| ЛС.Код КАК Код,
		| ЛС.Наименование КАК Наименование,
		| ЛС.Помещение КАК Помещение,
		| ЕСТЬNULL(Пом.Номер, """") КАК НомерПомещения,
		| Дома.Номер КАК НомерДома,
		| ЕСТЬNULL(Дома.Корпус, """") КАК Корпус
		|ИЗ
		| Справочник.ркЛицевыеСчета КАК ЛС
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ркДома КАК Дома
		| ПО ЛС.Дом = Дома.Ссылка
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ркУлицы КАК Улица
		| ПО Дома.Владелец = Улица.Ссылка
		| ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ркПомещения КАК Пом
		| ПО ЛС.Помещение = Пом.Ссылка
		|ГДЕ
		| ВРЕГ(Улица.Наименование) В (&Улицы)
		|УПОРЯДОЧИТЬ ПО
		| ЛС.Код";
	Запрос.УстановитьПараметр("Улицы", УлицыПоиска);
	// Ошибку запроса не превращаем в сообщение «ЛС не найден».
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НормализоватьЗначение(Выборка.НомерДома) <> ДомПоиска
			ИЛИ НормализоватьЗначение(Выборка.Корпус) <> КорпусПоиска Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура(
			"Ссылка, Код, Наименование, Помещение, НомерПомещения",
			Выборка.Ссылка, Выборка.Код, Выборка.Наименование,
			Выборка.Помещение, СокрЛП(Выборка.НомерПомещения)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Одним запросом собирает возможные ЛС по улицам и квартирам всех строк.

// Поиск ЛС по цепочке: улица → дом → помещение → ЛС (по кэшу).

// Приводит название улицы к единому виду: верхний регистр, без "ул".
&НаСервереБезКонтекста
Функция ПодготовитьУлицу(Улица)
	
	Результат = ВРег(СокрЛП(Улица));
	Результат = СтрЗаменить(Результат, " УЛ", "");
	Результат = СтрЗаменить(Результат, "УЛ.", "");
	Возврат СокрЛП(Результат);
	
КонецФункции

// Возвращает варианты написания квартиры: "9", "09", "9.0" → "9".
&НаСервереБезКонтекста
Функция ВариантыНаписанияКвартиры(Квартира)
	
	Квартира = СокрЛП(Квартира);
	Варианты = Новый Массив;
	Варианты.Добавить(Квартира);
	Варианты.Добавить("0" + Квартира);
	
	Если СтрПодобнаПоРегулярномуВыражению(Квартира, "^[0-9]+([.,][0-9]+)?$") Тогда
		ЧисловойВариант = СокрЛП(Число(Квартира));
		Если Варианты.Найти(ЧисловойВариант) = Неопределено Тогда
			Варианты.Добавить(ЧисловойВариант);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Варианты;
	
КонецФункции

// Приводит строку к единому виду: убирает пробелы, дефисы, точки.
&НаСервереБезКонтекста
Функция НормализоватьЗначение(Знач Значение)
	
	Результат = ВРег(СокрЛП(Значение));
	Результат = СтрЗаменить(Результат, " ",  "");
	Результат = СтрЗаменить(Результат, "-",  "");
	Результат = СтрЗаменить(Результат, ".",  "");
	Возврат Результат;
	
КонецФункции

// Добавляет значение в массив, если его там ещё нет.
&НаСервереБезКонтекста
Процедура ДобавитьВМассивБезДублей(Массив, Значение)
	
	Если Массив.Найти(Значение) = Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ЗаполнениеСуммНаСервере

// Обходит все строки и заполняет суммы, договоры и задолженность.
&НаСервере
Процедура ЗаполнитьСуммыНаСервере()
	Попытка
		КартаУслуг = СоответствиеУслуг(Истина);
		Если КартаУслуг = Неопределено Тогда
			ВывестиСообщение("Заполнение отменено. Настройте соответствия услуг.");
			Возврат;
		КонецЕсли;
		ДанныеНачислений = ПодготовитьДанныеНачислений();
		НеизвестныеУслуги = Новый Соответствие;
		Для Каждого ДанныеМесяца Из ДанныеНачислений Цикл
			Для Каждого Услуга Из ДанныеМесяца.Значение Цикл
				Если КартаУслуг.Получить(Услуга.Ключ) = Неопределено Тогда
					НеизвестныеУслуги.Вставить(Услуга.Ключ, Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Если НеизвестныеУслуги.Количество() > 0 Тогда
			Для Каждого Услуга Из НеизвестныеУслуги Цикл
				ВывестиСообщение("Нет настройки вида расчета: " + Строка(Услуга.Ключ));
			КонецЦикла;
			ВывестиСообщение("Заполнение отменено.");
			Возврат;
		КонецЕсли;
		ДанныеЗадолженности = ПодготовитьДанныеЗадолженности(КартаУслуг);
	Исключение
		ВывестиСообщение("Заполнение отменено: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	КоличествоОбработанных = 0;
	КоличествоПропущенных = 0;
	Для Каждого СтрокаТаблицы Из ТаблицаФайла Цикл
		
		ОбнулитьПоляСтроки(СтрокаТаблицы);
		
		// Строка без ЛС - оставляем в нулях
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.СсылкаНаЛС) Тогда
			СтрокаТаблицы.GLAVA1 = "";
			Продолжить;
		КонецЕсли;
		
		Период = РазобратьПериод(СтрокаТаблицы.PERIOD);
		Если Период = Неопределено Тогда
			ВывестиСообщение("Пропущена строка с некорректным периодом: [" + СтрокаТаблицы.PERIOD + "]");
			КоличествоПропущенных = КоличествоПропущенных + 1;
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.DOGOVOR1 = 1;
		
		ЗаполнитьСуммыЗаМесяц(СтрокаТаблицы, Период, КартаУслуг, ДанныеНачислений);
		ЗаполнитьДоговорыИГлавы(СтрокаТаблицы);
		ЗаполнитьЗадолженность(СтрокаТаблицы, Период, ДанныеЗадолженности);
		
		КоличествоОбработанных = КоличествоОбработанных + 1;
		
	КонецЦикла;
	
	ВывестиСообщение("Заполнено строк: " + КоличествоОбработанных);
	Если КоличествоПропущенных > 0 Тогда
		ВывестиСообщение("Пропущено строк с ошибками: " + КоличествоПропущенных);
	КонецЕсли;
	
КонецПроцедуры

// Обнуляет все поля строки перед заполнением.
&НаСервереБезКонтекста
Процедура ОбнулитьПоляСтроки(СтрокаТаблицы)
	
	Для НомерУслуги = 1 По 16 Цикл
		
		СтрокаТаблицы["SUM_N"   + НомерУслуги] = 0;
		СтрокаТаблицы["ZADOLG"  + НомерУслуги] = 0;
		СтрокаТаблицы["MZADOLG" + НомерУслуги] = 0;
		СтрокаТаблицы["DOGOVOR" + НомерУслуги] = 0;
		
		Если НомерУслуги >= 2 И НомерУслуги <= 15 Тогда
			СтрокаТаблицы["GLAVA" + НомерУслуги] = "";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Разбирает строку "ММ.ГГГГ" в структуру {Начало, Конец, Месяц, Год}.
&НаСервереБезКонтекста
Функция РазобратьПериод(ПериодИзФайла)
	
	ПериодИзФайла = СокрЛП(ПериодИзФайла);
	Если СтрДлина(ПериодИзФайла) < 7 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НомерМесяцаСтр = Лев(ПериодИзФайла, 2);
	НомерГодаСтр   = Прав(ПериодИзФайла, 4);
	Если Не СтрПодобнаПоРегулярномуВыражению(НомерМесяцаСтр, "^[0-9]+$")
		ИЛИ Не СтрПодобнаПоРегулярномуВыражению(НомерГодаСтр, "^[0-9]+$") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НомерМесяца = Число(НомерМесяцаСтр);
	НомерГода   = Число(НомерГодаСтр);
	
	Если НомерМесяца < 1 ИЛИ НомерМесяца > 12 ИЛИ НомерГода < 2000 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НачалоМесяца = Дата(НомерГода, НомерМесяца, 1);
	
	Результат = Новый Структура;
	Результат.Вставить("Начало", НачалоМесяца);
	Результат.Вставить("Конец",  КонецМесяца(НачалоМесяца));
	Результат.Вставить("Месяц",  НомерМесяца);
	Результат.Вставить("Год",    НомерГода);
	
	Возврат Результат;
	
КонецФункции

// Возвращает ключ "ЛицевойСчет|yyyyMM".
&НаСервереБезКонтекста
Функция КлючМесяца(ЛицевойСчет, ДатаПериода)
	
	Возврат Строка(ЛицевойСчет) + "|" + Формат(ДатаПериода, "ДФ=yyyyMM");
	
КонецФункции

// Одним запросом собирает начисления по всем ЛС и периодам.
&НаСервере
Функция ПодготовитьДанныеНачислений()
	
	Данные = Новый Соответствие;
	
	ЛицевыеСчета = Новый Массив;
	НачалоПериода = Неопределено;
	КонецПериода  = Неопределено;
	
	Для Каждого СтрокаТаблицы Из ТаблицаФайла Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.СсылкаНаЛС) Тогда
			Продолжить;
		КонецЕсли;
		
		Период = РазобратьПериод(СтрокаТаблицы.PERIOD);
		Если Период = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьВМассивБезДублей(ЛицевыеСчета, СтрокаТаблицы.СсылкаНаЛС);
		
		Если НачалоПериода = Неопределено ИЛИ Период.Начало < НачалоПериода Тогда
			НачалоПериода = Период.Начало;
		КонецЕсли;
		Если КонецПериода = Неопределено ИЛИ Период.Конец > КонецПериода Тогда
			КонецПериода = Период.Конец;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЛицевыеСчета.Количество() = 0 Тогда
		Возврат Данные;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛицевойСчет КАК ЛицевойСчет,
		|	ПериодЗадолженности КАК ПериодЗадолженности,
		|	ВидРасчета КАК ВидРасчета,
		|	Сумма КАК Сумма
		|ИЗ
		|	РегистрНакопления.ркЗадолженностьЛицевыхСчетов
		|ГДЕ
		|	ЛицевойСчет В (&ЛицевыеСчета)
		|	И ПериодЗадолженности МЕЖДУ &НачалоПериода И &КонецПериода";
	
	Запрос.УстановитьПараметр("ЛицевыеСчета",  ЛицевыеСчета);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",  КонецПериода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Ключ = КлючМесяца(Выборка.ЛицевойСчет, Выборка.ПериодЗадолженности);
		Услуги = Данные.Получить(Ключ);
		Если Услуги = Неопределено Тогда
			Услуги = Новый Соответствие;
			Данные.Вставить(Ключ, Услуги);
		КонецЕсли;
		ПредыдущаяСумма = Услуги.Получить(Выборка.ВидРасчета);
		Если ПредыдущаяСумма = Неопределено Тогда
			Услуги.Вставить(Выборка.ВидРасчета, Выборка.Сумма);
		Иначе
			// Прежний алгоритм: максимум записей одного вида расчета за месяц.
			Услуги.Вставить(Выборка.ВидРасчета,
				Макс(ПредыдущаяСумма, Выборка.Сумма));
		КонецЕсли;
	КонецЦикла;
	Возврат Данные;
КонецФункции

// Заполняет SUM_N1..SUM_N16 для строки по подготовленным данным.
&НаСервере
Процедура ЗаполнитьСуммыЗаМесяц(СтрокаТаблицы, Период, КартаУслуг, ДанныеНачислений)
	Услуги = ДанныеНачислений.Получить(
		КлючМесяца(СтрокаТаблицы.СсылкаНаЛС, Период.Начало));
	Если Услуги = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Услуга Из Услуги Цикл
		ИмяПоля = КартаУслуг.Получить(Услуга.Ключ);
		Если ИмяПоля = "Не выгружать" Тогда
			Продолжить;
		КонецЕсли;
		// Сохраняем прежние правила агрегирования полей файла.
		Если ИмяПоля = "SUM_N1" Тогда
			СтрокаТаблицы[ИмяПоля] = СтрокаТаблицы[ИмяПоля] + Макс(0, Услуга.Значение);
		Иначе
			СтрокаТаблицы[ИмяПоля] = Макс(СтрокаТаблицы[ИмяПоля], Услуга.Значение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Заполняет DOGOVOR{N} и GLAVA{N} для услуг 2..16.
&НаСервереБезКонтекста
Процедура ЗаполнитьДоговорыИГлавы(СтрокаТаблицы)
	
	Для НомерУслуги = 2 По 16 Цикл
		
		ИмяПоляСуммы    = "SUM_N"   + НомерУслуги;
		ИмяПоляДоговора = "DOGOVOR" + НомерУслуги;
		ИмяПоляГлавы    = "GLAVA"   + НомерУслуги;
		
		ЕстьСумма = (СтрокаТаблицы[ИмяПоляСуммы] > 0);
		
		Если ЕстьСумма Тогда
			СтрокаТаблицы[ИмяПоляДоговора] = 1;
			Если НомерУслуги <= 15 Тогда
				СтрокаТаблицы[ИмяПоляГлавы] = СтрокаТаблицы.GLAVA1;
			КонецЕсли;
		Иначе
			СтрокаТаблицы[ИмяПоляДоговора] = 0;
			Если НомерУслуги <= 15 Тогда
				СтрокаТаблицы[ИмяПоляГлавы] = "";
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Одним запросом собирает начисления и оплаты за 12 месяцев по всем ЛС.
&НаСервере
Функция ПодготовитьДанныеЗадолженности(КартаУслуг)
	
	Данные = Новый Структура("Начисления, Оплаты", Новый Соответствие, Новый Соответствие);
	
	ЛицевыеСчета = Новый Массив;
	НачалоПериода = Неопределено;
	КонецПериода  = Неопределено;
	
	Для Каждого СтрокаТаблицы Из ТаблицаФайла Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.СсылкаНаЛС) Тогда
			Продолжить;
		КонецЕсли;
		
		Период = РазобратьПериод(СтрокаТаблицы.PERIOD);
		Если Период = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьВМассивБезДублей(ЛицевыеСчета, СтрокаТаблицы.СсылкаНаЛС);
		
		НачалоГодаНазад = Дата(Период.Год - 1, Период.Месяц, 1);
		Если НачалоПериода = Неопределено ИЛИ НачалоГодаНазад < НачалоПериода Тогда
			НачалоПериода = НачалоГодаНазад;
		КонецЕсли;
		Если КонецПериода = Неопределено ИЛИ Период.Начало > КонецПериода Тогда
			КонецПериода = Период.Начало;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЛицевыеСчета.Количество() = 0 Тогда
		Возврат Данные;
	КонецЕсли;
	
	ЗаполнитьНачисленияЗадолженности(Данные.Начисления, ЛицевыеСчета, НачалоПериода, КонецПериода, КартаУслуг);
	ЗаполнитьОплатыЗадолженности(Данные.Оплаты, ЛицевыеСчета, НачалоПериода, КонецПериода, КартаУслуг);
	
	Возврат Данные;
	
КонецФункции

// Собирает месяцы с начислениями по всем ЛС.
&НаСервере
Процедура ЗаполнитьНачисленияЗадолженности(МесяцыСНачислениями, ЛицевыеСчета, НачалоПериода, КонецПериода, КартаУслуг)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЛицевойСчет КАК ЛицевойСчет,
		|	ВидРасчета КАК ВидРасчета,
		|	ПериодЗадолженности КАК ПериодЗадолженности
		|ИЗ
		|	РегистрНакопления.ркНачисления
		|ГДЕ
		|	ЛицевойСчет В (&ЛицевыеСчета)
		|	И ПериодЗадолженности >= &НачалоПериода
		|	И ПериодЗадолженности <  &КонецПериода
		|	И СуммаНачислений > 0";
	
	Запрос.УстановитьПараметр("ЛицевыеСчета",  ЛицевыеСчета);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",  КонецПериода);
	
	Выборка = Запрос.Выполнить().Выбрать();


	Пока Выборка.Следующий() Цикл
		
		ИмяПоля = КартаУслуг.Получить(Выборка.ВидРасчета);
		Если ИмяПоля = Неопределено Тогда
			ВызватьИсключение "Нет настройки вида расчета в задолженности: "
				+ Строка(Выборка.ВидРасчета);
		КонецЕсли;
		Если ИмяПоля = "Не выгружать" Тогда
			Продолжить;
		КонецЕсли;
		
		КлючЛС = Строка(Выборка.ЛицевойСчет);
		ПоЛС = МесяцыСНачислениями.Получить(КлючЛС);
		Если ПоЛС = Неопределено Тогда
			ПоЛС = Новый Соответствие;
			МесяцыСНачислениями.Вставить(КлючЛС, ПоЛС);
		КонецЕсли;
		
		ПоЛС.Вставить(ИмяПоля + "|" + Формат(Выборка.ПериодЗадолженности, "ДФ=yyyyMM"), Истина);
		
	КонецЦикла;
	
КонецПроцедуры

// Собирает месяцы с оплатами по всем ЛС.
&НаСервере
Процедура ЗаполнитьОплатыЗадолженности(МесяцыСОплатами, ЛицевыеСчета, НачалоПериода, КонецПериода, КартаУслуг)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЛицевойСчет КАК ЛицевойСчет,
		|	ВидРасчета КАК ВидРасчета,
		|	ПериодЗадолженности КАК ПериодЗадолженности
		|ИЗ
		|	РегистрНакопления.ркОплата
		|ГДЕ
		|	ЛицевойСчет В (&ЛицевыеСчета)
		|	И ПериодЗадолженности >= &НачалоПериода
		|	И ПериодЗадолженности <  &КонецПериода
		|	И Сумма > 0";
	
	Запрос.УстановитьПараметр("ЛицевыеСчета",  ЛицевыеСчета);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",  КонецПериода);
	
	Выборка = Запрос.Выполнить().Выбрать();


	Пока Выборка.Следующий() Цикл
		
		ИмяПоля = КартаУслуг.Получить(Выборка.ВидРасчета);
		Если ИмяПоля = Неопределено Тогда
			ВызватьИсключение "Нет настройки вида расчета в задолженности: "
				+ Строка(Выборка.ВидРасчета);
		КонецЕсли;
		Если ИмяПоля = "Не выгружать" Тогда
			Продолжить;
		КонецЕсли;
		
		КлючЛС = Строка(Выборка.ЛицевойСчет);
		ПоЛС = МесяцыСОплатами.Получить(КлючЛС);
		Если ПоЛС = Неопределено Тогда
			ПоЛС = Новый Соответствие;
			МесяцыСОплатами.Вставить(КлючЛС, ПоЛС);
		КонецЕсли;
		
		ПоЛС.Вставить(ИмяПоля + "|" + Формат(Выборка.ПериодЗадолженности, "ДФ=yyyyMM"), Истина);
		
	КонецЦикла;
	
КонецПроцедуры

// Считает ZADOLG и MZADOLG по подготовленным данным.
&НаСервере
Процедура ЗаполнитьЗадолженность(СтрокаТаблицы, Период, ДанныеЗадолженности)
	
	НачалоКлюч = Формат(Дата(Период.Год - 1, Период.Месяц, 1), "ДФ=yyyyMM");
	КонецКлюч  = Формат(Период.Начало, "ДФ=yyyyMM");
	
	КлючЛС = Строка(СтрокаТаблицы.СсылкаНаЛС);
	ПоНачислениям = ДанныеЗадолженности.Начисления.Получить(КлючЛС);
	ПоОплатам     = ДанныеЗадолженности.Оплаты.Получить(КлючЛС);
	
	Для НомерУслуги = 1 По 16 Цикл
		
		ИмяПоляСуммы = "SUM_N" + НомерУслуги;
		МесяцевДолга = 0;
		
		Если ПоНачислениям <> Неопределено Тогда
			Для Каждого Пара Из ПоНачислениям Цикл
				
				Разделитель = СтрНайти(Пара.Ключ, "|");
				Если Лев(Пара.Ключ, Разделитель - 1) <> ИмяПоляСуммы Тогда
					Продолжить;
				КонецЕсли;
				
				Месяц = Сред(Пара.Ключ, Разделитель + 1);
				Если Месяц < НачалоКлюч ИЛИ Месяц >= КонецКлюч Тогда
					Продолжить;
				КонецЕсли;
				
				Если ПоОплатам <> Неопределено И ПоОплатам.Получить(Пара.Ключ) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				МесяцевДолга = МесяцевДолга + 1;
				
			КонецЦикла;
		КонецЕсли;
		
		СтрокаТаблицы["MZADOLG" + НомерУслуги] = МесяцевДолга;
		СтрокаТаблицы["ZADOLG"  + НомерУслуги] = ?(МесяцевДолга > 0, 1, 0);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область ОбщиеФункции

// Список всех полей DBF-файла в порядке следования.
&НаСервереБезКонтекста
Функция ВсеПоляDBF()
	
	Возврат СтрРазделить(
		"RAION,KOD,ID_FIAS,ID_KLADR,PUNKT,STREET,HOUSE,KORP,FLAT,PERIOD," +
		"DOGOVOR1,GLAVA1,SUM_N1,ZADOLG1,MZADOLG1," +
		"DOGOVOR2,GLAVA2,SUM_N2,ZADOLG2,MZADOLG2," +
		"DOGOVOR3,GLAVA3,SUM_N3,ZADOLG3,MZADOLG3," +
		"DOGOVOR4,GLAVA4,SUM_N4,ZADOLG4,MZADOLG4," +
		"DOGOVOR5,GLAVA5,SUM_N5,ZADOLG5,MZADOLG5," +
		"DOGOVOR6,GLAVA6,SUM_N6,ZADOLG6,MZADOLG6," +
		"DOGOVOR7,GLAVA7,SUM_N7,ZADOLG7,MZADOLG7," +
		"DOGOVOR8,GLAVA8,SUM_N8,ZADOLG8,MZADOLG8," +
		"DOGOVOR9,GLAVA9,SUM_N9,ZADOLG9,MZADOLG9," +
		"DOGOVOR10,GLAVA10,SUM_N10,ZADOLG10,MZADOLG10," +
		"DOGOVOR11,GLAVA11,SUM_N11,ZADOLG11,MZADOLG11," +
		"DOGOVOR12,GLAVA12,SUM_N12,ZADOLG12,MZADOLG12," +
		"DOGOVOR13,GLAVA13,SUM_N13,ZADOLG13,MZADOLG13," +
		"DOGOVOR14,GLAVA14,SUM_N14,ZADOLG14,MZADOLG14," +
		"DOGOVOR15,GLAVA15,SUM_N15,ZADOLG15,MZADOLG15," +
		"DOGOVOR16,SUM_N16,ZADOLG16,MZADOLG16",
		",");
	
КонецФункции

// Проверенное соответствие: ссылка на вид расчета → поле соглашения.
&НаСервере
Функция СоответствиеУслуг(СохранитьНастройки = Ложь)
	ЗагрузитьВидыРасчетаНаСервере();
	Результат = Новый Соответствие;
	ЕстьОшибки = Ложь;
	СписокКатегорий = Элементы.НастройкиУслугКатегорияОбмена.СписокВыбора;
	Для Каждого СтрокаНастройки Из НастройкиУслуг Цикл
		Если Не ЗначениеЗаполнено(СтрокаНастройки.ВидРасчета) Тогда
			ВывестиСообщение("В настройках есть строка без вида расчета.");
			ЕстьОшибки = Истина;
			Продолжить;
		КонецЕсли;
		Категория = СокрЛП(СтрокаНастройки.КатегорияОбмена);
		Если Категория = "ИСКЛЮЧИТЬ" Тогда
			Категория = "Не выгружать";
			СтрокаНастройки.КатегорияОбмена = Категория;
		КонецЕсли;
		// Неиспользуемые ненастроенные услуги не блокируют текущий обмен.
		Если Категория = "Не настроено" ИЛИ ПустаяСтрока(Категория) Тогда
			Продолжить;
		КонецЕсли;
		Если СписокКатегорий.НайтиПоЗначению(Категория) = Неопределено Тогда
			ВывестиСообщение("Выберите категорию для вида расчета: "
				+ Строка(СтрокаНастройки.ВидРасчета));
			ЕстьОшибки = Истина;
			Продолжить;
		КонецЕсли;
		Если Результат.Получить(СтрокаНастройки.ВидРасчета) <> Неопределено Тогда
			ВывестиСообщение("Повторяется вид расчета: " + Строка(СтрокаНастройки.ВидРасчета));
			ЕстьОшибки = Истина;
			Продолжить;
		КонецЕсли;
		Результат.Вставить(СтрокаНастройки.ВидРасчета, Категория);
	КонецЦикла;
	Если ЕстьОшибки Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если СохранитьНастройки Тогда
		ХранилищеОбщихНастроек.Сохранить("ОбменУСЗН", "СоответствияУслугВерсия1",
			РеквизитФормыВЗначение("НастройкиУслуг"));
	КонецЕсли;
	Возврат Результат;
КонецФункции


// Выводит сообщение пользователю.
&НаСервереБезКонтекста
Процедура ВывестиСообщение(Знач Текст)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти
#Область НастройкаСоответствийУслуг

// Восстанавливает настройки текущего пользователя и добавляет новые виды расчета.
&НаСервере
Процедура ЗагрузитьВидыРасчетаНаСервере()
	ПолеКатегории = Элементы.НастройкиУслугКатегорияОбмена;
	ПолеКатегории.РежимВыбораИзСписка = Истина;
	Список = ПолеКатегории.СписокВыбора;
	Список.Очистить();
	Список.Добавить("Не настроено", "Не настроено");
	Список.Добавить("Не выгружать", "Не выгружать");
	Список.Добавить("SUM_N1", "Занимаемая площадь");
	Список.Добавить("SUM_N2", "Холодное водоснабжение");
	Список.Добавить("SUM_N3", "Горячее водоснабжение");
	Список.Добавить("SUM_N4", "Водоотведение");
	Список.Добавить("SUM_N5", "Центральное отопление");
	Список.Добавить("SUM_N6", "Вывоз бытовых отходов");
	Список.Добавить("SUM_N7", "Сетевое газоснабжение");
	Список.Добавить("SUM_N8", "Сжиженное газоснабжение");
	Список.Добавить("SUM_N9", "Электроэнергия");
	Список.Добавить("SUM_N10", "Лифт");
	Список.Добавить("SUM_N11", "Капитальный ремонт");
	Список.Добавить("SUM_N12", "КРСОИ холодная вода");
	Список.Добавить("SUM_N13", "КРСОИ горячая вода");
	Список.Добавить("SUM_N14", "КРСОИ электроэнергия");
	Список.Добавить("SUM_N15", "КРСОИ отведение сточных вод");
	Список.Добавить("SUM_N16", "Наем жилого помещения");

	Если НастройкиУслуг.Количество() = 0 Тогда
		СохраненныеНастройки = ХранилищеОбщихНастроек.Загрузить(
			"ОбменУСЗН", "СоответствияУслугВерсия1");
		Если ТипЗнч(СохраненныеНастройки) = Тип("ТаблицаЗначений") Тогда
			ЗначениеВРеквизитФормы(СохраненныеНастройки, "НастройкиУслуг");
		КонецЕсли;
	КонецЕсли;

	// Совместимость со старыми настройками обработки.
	Для Каждого СтрокаНастройки Из НастройкиУслуг Цикл
		Если СтрокаНастройки.КатегорияОбмена = "ИСКЛЮЧИТЬ" Тогда
			СтрокаНастройки.КатегорияОбмена = "Не выгружать";
		КонецЕсли;
	КонецЦикла;

	СуществующиеСтроки = Новый Соответствие;
	Для Каждого СтрокаНастройки Из НастройкиУслуг Цикл
		Если ЗначениеЗаполнено(СтрокаНастройки.ВидРасчета) Тогда
			СуществующиеСтроки.Вставить(СтрокаНастройки.ВидРасчета, СтрокаНастройки);
		КонецЕсли;
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Виды.Ссылка КАК ВидРасчета,
		| Виды.Тип КАК ТипРасчета
		|ИЗ
		| Справочник.ркВидыРасчетов КАК Виды
		|ГДЕ
		| НЕ Виды.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		| Виды.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаНастройки = СуществующиеСтроки.Получить(Выборка.ВидРасчета);
		Если СтрокаНастройки = Неопределено Тогда
			СтрокаНастройки = НастройкиУслуг.Добавить();
			СтрокаНастройки.ВидРасчета = Выборка.ВидРасчета;
			СтрокаНастройки.КатегорияОбмена = "Не настроено";
			СуществующиеСтроки.Вставить(Выборка.ВидРасчета, СтрокаНастройки);
		КонецЕсли;
		СтрокаНастройки.ТипРасчета = Выборка.ТипРасчета;
	КонецЦикла;
	// Заполняем только пустые категории, ручной выбор не перезаписываем.
	Для Каждого СтрокаНастройки Из НастройкиУслуг Цикл
		Если СтрокаНастройки.КатегорияОбмена = "Не настроено"
			ИЛИ ПустаяСтрока(СтрокаНастройки.КатегорияОбмена) Тогда
			СтрокаНастройки.КатегорияОбмена = ОпределитьКатегориюУслуги(
				Строка(СтрокаНастройки.ВидРасчета), СтрокаНастройки.ТипРасчета);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти


// Названия служат для первичного распознавания; сохраненные настройки — по ссылке.
// Неоднозначные названия остаются ненастроенными и требуют ручной категории.
&НаСервереБезКонтекста
Функция ОпределитьКатегориюУслуги(Наименование, ТипРасчета)

	// Начальные правила распределения услуг.
	// Категории можно переопределить в настройках конкретной базы.
	СтандартныеУслуги = Новый Соответствие;
	СтандартныеУслуги.Вставить("содержание и ремонт жилья", "SUM_N1");
	СтандартныеУслуги.Вставить("благоустройство территории", "SUM_N1");
	СтандартныеУслуги.Вставить("холодное водоснабжение", "SUM_N2");
	СтандартныеУслуги.Вставить("хвс по ипу", "SUM_N2");
	СтандартныеУслуги.Вставить("подогрев холодной воды", "SUM_N4");
	СтандартныеУслуги.Вставить("холодное водоснабжение для гвс", "SUM_N3");
	СтандартныеУслуги.Вставить("водоотведение", "SUM_N4");
	СтандартныеУслуги.Вставить("отопление", "SUM_N5");
	СтандартныеУслуги.Вставить("электроснабжение", "SUM_N9");
	СтандартныеУслуги.Вставить("раздел л/с по эл.энергии", "SUM_N9");
	СтандартныеУслуги.Вставить("водоснабжение при сои", "SUM_N12");
	СтандартныеУслуги.Вставить("электроснабжение при сои", "SUM_N14");
	СтандартныеУслуги.Вставить("водоотведение при сои", "SUM_N15");
	СтандартныеУслуги.Вставить("пени", "Не выгружать");
	СтандартныеУслуги.Вставить("то системы апс и соуэ", "Не выгружать");
	СтандартныеУслуги.Вставить("то оборудования кнс", "Не выгружать");
	СтандартныеУслуги.Вставить("то оборудования лос", "Не выгружать");
	СтандартныеУслуги.Вставить("предоставление места для электропровода", "Не выгружать");
	СтандартныеУслуги.Вставить("устранение засора канализации (гидродинамика)", "Не выгружать");
	СтандартныеУслуги.Вставить("откачка сточных вод канализации", "Не выгружать");
	СтандартныеУслуги.Вставить("обслуживание газовой котельной", "Не выгружать");
	СтандартныеУслуги.Вставить("обслуживание бассейна", "Не выгружать");
	СтандартныеУслуги.Вставить("плата за негативное возд. на цсв", "Не выгружать");
	СтандартныеУслуги.Вставить("дезинсекция", "Не выгружать");
	СтандартныеУслуги.Вставить("видеонаблюдение", "Не выгружать");
	СтандартныеУслуги.Вставить("домофон", "Не выгружать");
	СтандартныеУслуги.Вставить("госполина", "Не выгружать");
	СтандартныеУслуги.Вставить("вознаграждение работы председателя совета дома", "Не выгружать");
	СтандартныеУслуги.Вставить("работы по укреплению и защите кровельного покрытия", "Не выгружать");
	СтандартныеУслуги.Вставить("уборка мусорного контейнера", "Не выгружать");
	СтандартныеУслуги.Вставить("внесение изменений в технический паспорт здания", "Не выгружать");
	ИсходноеНазвание = НРег(СокрЛП(Наименование));
	ИсходноеНазвание = СтрЗаменить(ИсходноеНазвание, Символ(160), " ");
	ИсходноеНазвание = СтрЗаменить(ИсходноеНазвание, Символы.Таб, " ");
	Пока СтрНайти(ИсходноеНазвание, "  ") > 0 Цикл
		ИсходноеНазвание = СтрЗаменить(ИсходноеНазвание, "  ", " ");
	КонецЦикла;
	СтандартнаяКатегория = СтандартныеУслуги.Получить(ИсходноеНазвание);
	Если СтандартнаяКатегория <> Неопределено Тогда
		Возврат СтандартнаяКатегория;
	КонецЕсли;
	Если ТипРасчета = Перечисления.ркТипыВидовРасчетов.Пени
		ИЛИ ТипРасчета = Перечисления.ркТипыВидовРасчетов.Госпошлина
		ИЛИ ТипРасчета = Перечисления.ркТипыВидовРасчетов.БанковскийПроцент Тогда
		Возврат "Не выгружать";
	КонецЕсли;
	Название = НРег(СокрЛП(Наименование));
	Название = СтрЗаменить(Название, "ё", "е");
	Название = СтрЗаменить(Название, Символ(160), " ");
	Название = СтрЗаменить(Название, ".", " ");
	Название = СтрЗаменить(Название, "-", " ");
	Название = СтрЗаменить(Название, "(", " ");
	Название = СтрЗаменить(Название, ")", " ");
	Название = СтрЗаменить(Название, Символы.Таб, " ");
	Пока СтрНайти(Название, "  ") > 0 Цикл
		Название = СтрЗаменить(Название, "  ", " ");
	КонецЦикла;
	Название = " " + СокрЛП(Название) + " ";
	ЭтоСОИ = Ложь;
	Для Каждого Уточнение Из СтрРазделить(
		"крсои|при сои|на сои|сои|одн|на общедомовые нужды", "|") Цикл
		Если СтрНайти(Название, " " + Уточнение + " ") > 0 Тогда
			ЭтоСОИ = Истина;
			Название = СтрЗаменить(Название, " " + Уточнение + " ", " ");
		КонецЕсли;
	КонецЦикла;
	Для Каждого Уточнение Из СтрРазделить(
		"по ипу|по одпу|по нормативу|по счетчику|по счетчикам|ипу|одпу", "|") Цикл
		Название = СтрЗаменить(Название, " " + Уточнение + " ", " ");
	КонецЦикла;
	Пока СтрНайти(Название, "  ") > 0 Цикл
		Название = СтрЗаменить(Название, "  ", " ");
	КонецЦикла;
	Название = СокрЛП(Название);
	Словарь = Новый Соответствие;
	Словарь.Вставить("занимаемая площадь", "SUM_N1");
	Словарь.Вставить("содержание и ремонт жилья", "SUM_N1");
	Словарь.Вставить("содержание жилья", "SUM_N1");
	Словарь.Вставить("содержание жилого помещения", "SUM_N1");
	Словарь.Вставить("хв", "SUM_N2");
	Словарь.Вставить("вх", "SUM_N2");
	Словарь.Вставить("хвс", "SUM_N2");
	Словарь.Вставить("вода холодная", "SUM_N2");
	Словарь.Вставить("холодная вода", "SUM_N2");
	Словарь.Вставить("холодное водоснабжение", "SUM_N2");
	Словарь.Вставить("водоснабжение холодное", "SUM_N2");
	Словарь.Вставить("гв", "SUM_N3");
	Словарь.Вставить("вг", "SUM_N3");
	Словарь.Вставить("гвс", "SUM_N3");
	Словарь.Вставить("вода горячая", "SUM_N3");
	Словарь.Вставить("горячая вода", "SUM_N3");
	Словарь.Вставить("горячее водоснабжение", "SUM_N3");
	Словарь.Вставить("водоснабжение горячее", "SUM_N3");
	Словарь.Вставить("холодное водоснабжение для гвс", "SUM_N3");
	Словарь.Вставить("водоотведение", "SUM_N4");
	Словарь.Вставить("канализация", "SUM_N4");
	Словарь.Вставить("отведение сточных вод", "SUM_N4");
	Словарь.Вставить("отопление", "SUM_N5");
	Словарь.Вставить("центральное отопление", "SUM_N5");
	Словарь.Вставить("отопление центральное", "SUM_N5");
	Словарь.Вставить("вывоз бытовых отходов", "SUM_N6");
	Словарь.Вставить("обращение с тко", "SUM_N6");
	Словарь.Вставить("вывоз тко", "SUM_N6");
	Словарь.Вставить("вывоз тбо", "SUM_N6");
	Словарь.Вставить("тко", "SUM_N6");
	Словарь.Вставить("тбо", "SUM_N6");
	Словарь.Вставить("сетевое газоснабжение", "SUM_N7");
	Словарь.Вставить("газоснабжение сетевое", "SUM_N7");
	Словарь.Вставить("газ сетевой", "SUM_N7");
	Словарь.Вставить("сжиженное газоснабжение", "SUM_N8");
	Словарь.Вставить("газоснабжение сжиженное", "SUM_N8");
	Словарь.Вставить("сжиженный газ", "SUM_N8");
	Словарь.Вставить("электроэнергия", "SUM_N9");
	Словарь.Вставить("электроснабжение", "SUM_N9");
	Словарь.Вставить("электрическая энергия", "SUM_N9");
	Словарь.Вставить("эл энергия", "SUM_N9");
	Словарь.Вставить("лифт", "SUM_N10");
	Словарь.Вставить("содержание лифта", "SUM_N10");
	Словарь.Вставить("обслуживание лифта", "SUM_N10");
	Словарь.Вставить("капитальный ремонт", "SUM_N11");
	Словарь.Вставить("капремонт", "SUM_N11");
	Словарь.Вставить("взнос на капитальный ремонт", "SUM_N11");
	Словарь.Вставить("взносы на капитальный ремонт", "SUM_N11");
	Словарь.Вставить("наем жилого помещения", "SUM_N16");
	Словарь.Вставить("наем жилья", "SUM_N16");
	Словарь.Вставить("социальный наем", "SUM_N16");
	Категория = Словарь.Получить(Название);
	Если Категория = Неопределено Тогда
		Возврат "Не настроено";
	КонецЕсли;
	Если ЭтоСОИ Тогда
		Если Категория = "SUM_N2" Тогда
			Возврат "SUM_N12";
		ИначеЕсли Категория = "SUM_N3" Тогда
			Возврат "SUM_N13";
		ИначеЕсли Категория = "SUM_N9" Тогда
			Возврат "SUM_N14";
		ИначеЕсли Категория = "SUM_N4" Тогда
			Возврат "SUM_N15";
		Иначе
			Возврат "Не настроено";
		КонецЕсли;
	КонецЕсли;
	Возврат Категория;
КонецФункции

&НаСервере
Процедура СохранитьСоответствияУслугНаСервере()

	ХранилищеОбщихНастроек.Сохранить(
		"ОбменУСЗН",
		"СоответствияУслугВерсия1",
		РеквизитФормыВЗначение("НастройкиУслуг"));

КонецПроцедуры

&НаКлиенте
Процедура НастройкиУслугКатегорияОбменаПриИзменении(Элемент)

	СохранитьСоответствияУслугНаСервере();

	Если ТаблицаФайла.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЕстьЛицевыеСчета = Ложь;

	Для Каждого СтрокаТаблицы Из ТаблицаФайла Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.СсылкаНаЛС) Тогда
			ЕстьЛицевыеСчета = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьЛицевыеСчета Тогда
		ЗаполнитьСуммыНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СброситьНастройкиУслуг(Команда)

	СброситьНастройкиУслугНаСервере();

	ЗагрузитьВидыРасчетаНаСервере();

	Если ТаблицаФайла.Количество() = 0 Тогда
		ВывестиСообщение("Настройки услуг сброшены.");
		Возврат;
	КонецЕсли;

	ЕстьЛицевыеСчета = Ложь;

	Для Каждого СтрокаТаблицы Из ТаблицаФайла Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.СсылкаНаЛС) Тогда
			ЕстьЛицевыеСчета = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьЛицевыеСчета Тогда
		ЗаполнитьСуммыНаСервере();
	Иначе
		ВывестиСообщение("Настройки сброшены. Лицевые счета ещё не заполнены.");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СброситьНастройкиУслугНаСервере()

	НастройкиУслуг.Очистить();

	ХранилищеОбщихНастроек.Удалить(
		"ОбменУСЗН",
		"СоответствияУслугВерсия1",
		ИмяПользователя());

КонецПроцедуры
